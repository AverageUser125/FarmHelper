{
  "schemaVersion": 1,
  "id": "farmhelper",
  "version": "${version}",
  "name": "FarmHelper",
  "description": "This Mod makes stuff glow",
  "authors": [
    "NaorVaninu"
  ],
  "license": "GPLv3",
  "icon": "icon-mod/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.jelly.farmhelper.Main"
    ]
  },
  "mixins": [
    "farmhelper.mixins.json"
  ],
  "accessWidener" : "farmhelper.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "environment:client"
      ]
    }
  }
}